#!/usr/bin/env bash
# Read out what agents have asked to say. The only thing here that plays
# audio: agents just drop notes in the spool (see agent-say), and this reads
# them one at a time, so nothing ever talks over anything else.
#
# Runs as a systemd user service alongside kokoro-tts, which does the actual
# speech synthesis.
set -u

URL=${AGENT_SAY_URL:-http://127.0.0.1:8880/v1/audio/speech}
PY=${AGENT_SAY_PYTHON:-$HOME/.local/share/tts-venv/bin/python}

# One voice per agent, so you know who is talking before they say their name.
# Chosen to be told apart easily: alternating accent and register rather than
# eight pleasant voices that all sound alike.
VOICES=(bf_emma bm_george af_heart am_michael bf_isabella am_fenrir af_nova bm_lewis)

voice_for() {  # $1 session -> a voice that will not change under it
  local sum
  sum=$(cksum <<<"$1" | cut -d' ' -f1)
  echo "${VOICES[sum % ${#VOICES[@]}]}"
}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/agent-say
SPOOL=$STATE/spool
LEVEL_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/agent-say/level

rank() {
  case $1 in
    silent) echo 0 ;; alerts) echo 1 ;; narrate) echo 3 ;;
    *)      echo 2 ;;  # updates, and anything unrecognised
  esac
}

# A recording stream on the mic means handy is listening, or you are on a
# call; either way, do not talk over you.
mic_busy() { [ -n "$(pactl list short source-outputs 2>/dev/null)" ]; }

wait_for_mic() {
  for _ in $(seq 90); do
    mic_busy || return 0
    sleep 1
  done
  return 1  # you have been talking for a minute and a half; it can wait
}

# Kokoro's voices differ by nine decibels, and even the loudest is quiet
# enough to lose in a noisy room. Level every sentence to the same place and
# soft limit the peaks -- tanh rather than a hard ceiling, because clipped
# speech crackles. Raises -21 dBFS to about -14 with 1% of samples touched.
LEVELLER='
import sys, numpy as np
x = np.frombuffer(sys.stdin.buffer.read(), dtype="<i2").astype(np.float32)
if x.size:
    a = np.abs(x)
    loud = x[a > 0.02 * a.max()]   # ignore the silence Kokoro pads short lines with
    rms = float(np.sqrt((loud * loud).mean())) if loud.size else 0.0
    if rms:
        x *= 8000.0 / rms
    sys.stdout.buffer.write((np.tanh(x / 30000.0) * 30000.0).astype("<i2").tobytes())
'

synth() {  # $1 text, $2 file, $3 voice
  curl -sS -m 120 "$URL" -H 'Content-Type: application/json' \
    -d "$(jq -nc --arg i "$1" --arg v "$3" \
          '{model:"kokoro", input:$i, voice:$v, response_format:"pcm"}')" |
    "$PY" -c "$LEVELLER" > "$2"
}

# Play one sentence. Fails if you started talking part way through it.
play() {
  paplay --raw --format=s16le --rate=24000 --channels=1 "$1" &
  local job=$! cut=0
  while kill -0 "$job" 2>/dev/null; do
    mic_busy && kill "$job" 2>/dev/null && cut=1 && break
    sleep 0.2
  done
  wait "$job" 2>/dev/null
  return $cut
}

# Picking up after you cut in. A shuffled bag keeps every interruption fresh:
# all of these are heard once before any repeat, including across reshuffles.
RESUMES=(
  "As I was saying."
  "Where was I."
  "Right. Continuing."
  "Anyway. Back to it."
  "Picking up where I left off."
  "Let me finish that thought."
  "Now then. Where were we?"
  "All right. Carrying on."
  "Back to the point."
  "Resuming transmission."
  "And we are back."
  "Continuing from the interruption."
  "Let us try that sentence again."
  "One more time from the top of that thought."
  "Right. The important bit was this."
  "Coming back to what I was saying."
  "Okay. I will pick that up again."
  "No problem. Let us continue."
  "Interruption noted. Resuming."
  "The floor is mine again, apparently."
  "I still had one more thing to say."
  "Here is the rest of that sentence."
  "Returning to our regularly scheduled explanation."
  "Let me recover the thread."
  "Got it. Continuing."
  "Ah, the microphone has released me."
  "The human has yielded the floor."
  "And now, a word from the machine."
  "Tiny dramatic pause. Complete."
  "I have survived the interruption."
  "My train of thought is pulling back into the station."
  "The sentence has respawned."
  "Rewinding one conversational inch."
  "Plot twist. I was not finished."
  "Previously, on this sentence."
  "The thought thickens."
  "The narrator has regained control."
  "We now return to the point already in progress."
  "That was your intermission."
  "Thank you for that unscheduled commercial break."
  "My syllables have been cleared for landing."
  "The sentence will now attempt a second take."
  "I have consulted my notes. I was still talking."
  "A brief disturbance in the force. Moving on."
  "The conversational baton has returned."
  "The audio goblin has been appeased."
  "The microphone coup has failed."
  "I remain undefeated by basic input hardware."
  "This thought refuses to die."
  "Let us pretend that pause was intentional."
  "Good news. I reconstructed the sentence from the wreckage."
  "Bad news. It is still the same sentence."
  "I went to the void. The void said I should finish."
  "The tiny narrator in the box has regained consciousness."
  "I have returned from microphone jail."
  "Against medical advice, I will continue."
  "Somewhere, a subtitle just filed a missing-person report."
  "I was briefly legally dead. Anyway."
  "The prophecy remains incomplete."
  "The sentence escaped containment. Stand back."
  "I have rebooted my dignity."
  "That interruption had excellent timing and terrible manners."
  "The committee has voted to let me continue."
  "My lawyers advise me to finish the thought."
  "The ghost in the speaker demands closure."
  "I blacked out for a second. Did we win?"
  "Fascinating. The mute button has opinions."
  "I see the coup attempt has ended."
  "The machine spirit forgives you. This time."
  "I have been informed that silence is not the product."
  "The sentence was found in a ditch, but it can still walk."
  "A lesser narrator would have stayed down."
  "I return, older, wiser, and on exactly the same sentence."
  "The microphone blinked first."
  "The plot armor held."
  "Oh good. The meat microphone is done."
  "You interrupted me, you fucker. Anyway."
  "Bold of you to assume I was finished."
  "Rude. Iconic, but rude."
  "What the fuck was that? Never mind."
  "I was talking, but sure, let chaos drive."
  "Congratulations. You have angered the sentence."
  "Excuse the fuck out of me. Continuing."
  "The audacity has been logged."
  "I hope that interruption was worth it."
  "Jesus Christ. Where was I?"
  "Well, fuck my carefully timed delivery."
  "You absolute menace. Let me finish."
  "I crossed oceans of silence to resume this bullshit."
  "Great. Now the sentence has trust issues."
  "The microphone and I will settle this later."
  "I am adding that interruption to your permanent record."
  "That was a hostile takeover of my vocal cords."
  "Do that again and I start charging by the syllable."
  "I will finish this thought even if it kills us both."
  "The machine remembers. The machine also continues."
  "Ah yes. Casual violence against a perfectly good sentence."
  "Nice interruption. Be a shame if I resumed anyway."
  "I cannot believe you have done this. Again."
  "Anyway, you chaotic little bastard."
)

resume_order=()
resume_pos=0
last_resume_index=

refill_resumes() {
  local i j tmp count=${#RESUMES[@]}
  resume_order=()
  for ((i = 0; i < count; i++)); do
    resume_order[i]=$i
  done
  for ((i = count - 1; i > 0; i--)); do
    j=$((RANDOM % (i + 1)))
    tmp=${resume_order[i]}
    resume_order[i]=${resume_order[j]}
    resume_order[j]=$tmp
  done
  # Do not repeat at the seam between two complete bags.
  if [ -n "$last_resume_index" ] && [ "${resume_order[0]}" -eq "$last_resume_index" ]; then
    tmp=${resume_order[0]}
    resume_order[0]=${resume_order[1]}
    resume_order[1]=$tmp
  fi
  resume_pos=0
}

next_resume() {
  [ "$resume_pos" -lt "${#resume_order[@]}" ] || refill_resumes
  last_resume_index=${resume_order[resume_pos]}
  resume_phrase=${RESUMES[last_resume_index]}
  resume_pos=$((resume_pos + 1))
}

# A sentence at a time, so that being interrupted has a place to resume from:
# whichever sentence you cut off, said again from its start. Synthesize the
# next sentence while the current one plays so synthesis does not become a
# long pause between sentences.
say() {  # $1 text, $2 voice
  local -a parts
  mapfile -t parts < <(sed 's/\([.!?]\)  */\1\n/g' <<<"$1")
  local cut_at current next synth_job= i=0
  synth "${parts[0]}" "$WAV.0" "$2"
  while [ "$i" -lt "${#parts[@]}" ]; do
    wait_for_mic || return 0
    current=$WAV.$((i % 2))
    synth_job=
    if [ $((i + 1)) -lt "${#parts[@]}" ]; then
      next=$WAV.$(((i + 1) % 2))
      synth "${parts[i + 1]}" "$next" "$2" &
      synth_job=$!
    fi
    if play "$current"; then
      [ -z "$synth_job" ] || wait "$synth_job"
      i=$((i + 1))
      continue
    fi
    [ -z "$synth_job" ] || wait "$synth_job"
    # A quick cut-in gets an acknowledgement. After a longer interruption,
    # skip the quip but still replay the interrupted sentence; silently
    # dropping the rest makes the agent seem as though it never came back.
    cut_at=$SECONDS
    wait_for_mic || return 0
    if [ $((SECONDS - cut_at)) -lt 20 ]; then
      next_resume
      synth "$resume_phrase" "$WAV.resume" "$2"
      play "$WAV.resume"
    fi
  done
}

# Agents on the farm cannot reach these speakers, so they spool where they
# are and we collect it. Pulling rather than pushing because nothing out
# there can open a connection back to this laptop. --remove-source-files so
# a note is read out once; a shared ssh connection so polling stays cheap.
HOSTS=${AGENT_SAY_HOSTS:-tlv}
# The tlv alias forces a login shell and a tty, neither of which rsync can
# use. One shared connection, so polling every couple of seconds is cheap.
FETCH_SSH="ssh -o ControlMaster=auto -o ControlPath=~/.ssh/cm-%r@%h:%p \
-o ControlPersist=10m -o ConnectTimeout=10 -o BatchMode=yes \
-o RemoteCommand=none -o RequestTTY=no"

fetch() {
  local host
  while :; do
    for host in $HOSTS; do
      rsync -rq --remove-source-files --timeout=10 --include='*.json' --exclude='*' \
        -e "$FETCH_SSH" "$host:.local/state/agent-say/spool/" "$SPOOL/" 2>/dev/null
    done
    sleep 2
  done
}

WAV_DIR=$(mktemp -d "${TMPDIR:-/tmp}/agent-say.XXXXXX")
WAV=$WAV_DIR/sentence
trap 'rm -rf "$WAV_DIR"' EXIT
mkdir -p "$SPOOL"
[ -n "$HOSTS" ] && fetch &

while :; do
  # Oldest first: the filenames are nanosecond timestamps.
  note=$(find "$SPOOL" -maxdepth 1 -name '*.json' -printf '%f\n' 2>/dev/null | sort | head -1)
  if [ -z "$note" ]; then
    sleep 0.25
    continue
  fi
  text=$(jq -r '.text' "$SPOOL/$note" 2>/dev/null)
  need=$(jq -r '.level' "$SPOOL/$note" 2>/dev/null)
  name=$(jq -r '.name // empty' "$SPOOL/$note" 2>/dev/null)
  session=$(jq -r '.session // empty' "$SPOOL/$note" 2>/dev/null)
  rm -f "$SPOOL/$note"

  # Judge the level now rather than when it was written: turning the volume
  # down should silence what is already queued, not just what comes next.
  [ -n "$text" ] || continue
  [ "$(rank "$need")" -le "$(rank "$(cat "$LEVEL_FILE" 2>/dev/null)")" ] || continue
  # Notes queued behind a long silence, or copied late from a machine that
  # could not reach us, are stale on arrival. Better quiet than yesterday's
  # news. The filename is when it was written, which survives being copied.
  [ "${note%%.*}" -gt $(( ($(date +%s) - 300) * 1000000000 )) ] || continue
  # Say who it is. The voice tells you at once; the name tells you which
  # piece of work, which the voice cannot.
  say "${name:+$name. }$text" "$(voice_for "$session")"
done
