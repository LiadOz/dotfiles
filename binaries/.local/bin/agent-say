#!/usr/bin/env bash
# Ask for something to be said out loud, so an agent can talk back to you.
#
#   agent-say "the build is done"      # free-form; only heard at `narrate`
#   agent-say -l alerts "I am stuck"   # speak unless you have gone silent
#   agent-say hook claude|codex        # from a hook, payload on stdin
#   agent-say level updates            # how much you want to hear, right now
#   agent-say level                    # what it is set to
#
# This only writes a note to a spool directory and returns; agent-say-daemon
# is the one thing that ever plays audio. So an agent never waits on a
# sentence, agents cannot talk over each other because only one process
# speaks, and an agent on a remote machine works exactly the same way -- its
# notes are copied into this spool and read out here.
#
# The level describes you, not the agent: whether you are looking at the
# screen. So it is one global setting, and turning it down quietens every
# agent you are running, wherever it is running.
#
#   silent   nothing at all -- reading along, on a call, not alone
#   alerts   only when an agent is blocked on you
#   updates  ...and when one finishes, by name, so you know who wants you
#   narrate  ...and agents talking freely, and reading you their answer
set -u

STATE=${XDG_STATE_HOME:-$HOME/.local/state}/agent-say
LEVEL_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/agent-say/level
SESSION=${CLAUDE_CODE_SESSION_ID:-$$}

level() { cat "$LEVEL_FILE" 2>/dev/null || echo updates; }

# $1 minimum level this is worth hearing at, $2 what to say. Named after the
# host so you can tell where an agent is speaking from once this is running
# on the farm as well.
spool() {
  [ -n "${2// /}" ] || return 0
  mkdir -p "$STATE/spool"
  jq -nc --arg l "$1" --arg t "$2" --arg h "$(hostname -s)" \
    '{level: $l, text: $t, host: $h}' \
    > "$STATE/spool/$(date +%s%N).$$.json"
}

# What this session is called, so you can tell agents apart by ear.
# agent-state records it per tmux window, keyed by the session that claimed
# the window.
title() {
  jq -r --arg o "$1" 'select(.owner == $o) | .title // empty' \
    "$HOME/.local/state/agent-slots"/*.json 2>/dev/null | head -1
}

# The agent's closing message, for reading back at `narrate`. codex hands it
# over directly; claude only points at the transcript.
answer() {
  local text
  text=$(jq -r '.last_assistant_message // empty' <<<"$1")
  if [ -z "$text" ]; then
    text=$(jq -r 'select(.type == "assistant") | .message.content[]?
                  | select(.type == "text") | .text' \
           "$(jq -r '.transcript_path // "/dev/null"' <<<"$1")" 2>/dev/null | tail -1)
  fi
  # Code and tables are unlistenable, and a long answer outlives your patience.
  sed -e '/^```/,/^```/d' -e 's/[|#*`]//g' <<<"$text" | tr -s ' \n' ' ' | cut -c1-1500
}

hook() {
  local payload event session name need line
  payload=$(cat)
  event=$(jq -r '.hook_event_name // .type // empty' <<<"$payload")
  session=$(jq -r '.session_id // empty' <<<"$payload")
  name=$(title "$session")
  name=${name:-$1}

  case $event in
    # Claude phrases its own notification; it is more specific than anything
    # we could infer, so pass it through.
    Notification)      need=alerts;  line="$name. $(jq -r '.message // "needs you"' <<<"$payload")" ;;
    PermissionRequest) need=alerts;  line="$name is asking permission." ;;
    Stop)
      need=updates
      line="$name is done."
      # Away from the screen, what you want is the answer, not the fact that
      # there is one -- unless this session has been narrating, in which case
      # it has already told you and reading its closing message back is just
      # saying everything twice.
      [ "$(level)" = narrate ] &&
        [ -z "$(find "$STATE/narrated/$session" -newermt '-3 minutes' 2>/dev/null)" ] &&
        line="$name says. $(answer "$payload")"
      ;;
    *) return 0 ;;
  esac
  spool "$need" "$line"
}

case ${1:-} in
  hook)
    hook "${2:-agent}"
    ;;
  level)
    if [ -n "${2:-}" ]; then
      mkdir -p "$(dirname "$LEVEL_FILE")"
      printf '%s\n' "$2" > "$LEVEL_FILE"
    fi
    level
    ;;
  -l)
    spool "$2" "${*:3}"
    ;;
  *)
    mkdir -p "$STATE/narrated"
    touch "$STATE/narrated/$SESSION"
    spool narrate "${*:-$(cat)}"
    ;;
esac
