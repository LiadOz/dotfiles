#!/usr/bin/env python3
"""Record one coding-agent session for the tmux status bar.

The agent may run on LSF and cannot contact the tmux server. It does not need
to: tmux exports its server and pane ids into the process environment. This
script stores those ids with the session; agent-sync performs the only
pane-to-window mapping on the tmux host.
"""
import json
import os
import pathlib
import sys
import time

STATE_DIR = pathlib.Path.home() / ".local/state/agent-slots"
SESSION_DIR = STATE_DIR / "sessions"

# claude keeps one small file per running session here, keyed by pid, with
# the name you gave it via /rename. That name beats anything we could infer.
CLAUDE_SESSIONS = pathlib.Path.home() / ".claude/sessions"

# hook event -> flag shown in the status bar. claude and codex use the same
# event names, so one table serves both.
EVENTS = {
    "SessionStart": "idle",     # occupied, nothing pending
    "UserPromptSubmit": "working",
    "PermissionRequest": "blocked",
    "PostToolUse": "working",   # you answered the prompt; stop showing blocked
    "Stop": "done",
}


def remove(target):
    try:
        target.unlink()
    except FileNotFoundError:
        pass

def environment_owner():
    return (os.environ.get("CODEX_THREAD_ID")
            or os.environ.get("CLAUDE_CODE_SESSION_ID", ""))


def session_owner(data):
    return (data.get("session_id") or environment_owner()
            or f"{os.uname().nodename}:{os.getppid()}")


def session_path(value):
    return SESSION_DIR / f"{value.replace('/', '_')}.json"


def load(value):
    try:
        return json.loads(session_path(value).read_text())
    except (OSError, ValueError):
        return {}


def save(value, record):
    record["owner"] = value
    tmux = os.environ.get("TMUX", "").rsplit(",", 2)
    pane = os.environ.get("TMUX_PANE", "")
    if len(tmux) == 3 and pane:
        if record.get("server") != tmux[1] or record.get("pane") != pane:
            record["started"] = int(time.time() * 1000)
        record["server"] = tmux[1]
        record["pane"] = pane
    record["updated"] = int(time.time() * 1000)
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    target = session_path(value)
    tmp = target.with_suffix(".tmp")
    tmp.write_text(json.dumps(record))
    tmp.replace(target)


def set_state(value, record, state, **fields):
    if record.get("state") != state:
        record["since"] = int(time.time())
    record["state"] = state
    record.update({k: v for k, v in fields.items() if v})
    save(value, record)


def payload(args):
    """claude passes hook JSON on stdin; codex has passed it as an argument.
    Accept either rather than depending on which one this version does."""
    for arg in args:
        if arg.startswith("{"):
            try:
                return json.loads(arg)
            except ValueError:
                pass
    try:
        if not sys.stdin.isatty():
            return json.load(sys.stdin)
    except (ValueError, OSError):
        pass
    return {}


UUID_CHARS = set("0123456789abcdef-")


def thread_id(data):
    """The conversation id, whatever this agent calls it.

    codex has used thread-id, thread_id and conversation_id across versions,
    so match on shape rather than pinning one spelling: an id-ish key whose
    value looks like a uuid.
    """
    for key, value in data.items():
        if not isinstance(value, str) or len(value) < 32:
            continue
        if not set(value.lower()) <= UUID_CHARS:
            continue
        low = key.lower().replace("-", "_")
        if any(w in low for w in ("thread", "conversation", "session")):
            return value
    return ""


def input_workdir(value):
    if isinstance(value, str):
        start = value.find("{")
        try:
            value = json.JSONDecoder().raw_decode(value[start:])[0]
        except (ValueError, TypeError):
            return ""
    if not isinstance(value, dict):
        return ""
    workdir = value.get("workdir") or value.get("cwd")
    if isinstance(workdir, str) and os.path.isdir(workdir):
        return workdir
    return ""


def transcript_workdir(data):
    """Last explicit tool workdir when Codex omits PostToolUse."""
    path = data.get("transcript_path")
    if not isinstance(path, str) or not os.path.isfile(path):
        return ""
    workdir = ""
    try:
        for line in pathlib.Path(path).open():
            row = json.loads(line)
            candidate = input_workdir(row.get("payload", {}).get("input"))
            if candidate:
                workdir = candidate
    except (OSError, ValueError):
        return workdir
    return workdir


def cmd_hook(args):
    kind = next((a for a in args if a in ("claude", "codex")), "")
    data = payload(args)
    value = session_owner(data)
    event = data.get("hook_event_name") or data.get("type", "")

    # codex's older notify path only ever reports turn completion
    if event == "agent-turn-complete":
        event = "Stop"

    ending = event in ("SessionEnd", "agent-turn-end")
    if event not in EVENTS and not ending:
        return

    record = load(value)
    if ending:
        set_state(value, record, "free", agent=kind,
                  cwd=record.get("cwd", "") or data.get("cwd", ""),
                  thread=thread_id(data))
        return

    state = EVENTS[event]

    if event == "SessionStart":
        record.setdefault("started", int(time.time() * 1000))
        cwd = record.get("cwd", "") or data.get("cwd", "")
        set_state(value, record, "idle", agent=kind, cwd=cwd,
                  thread=thread_id(data))
        return

    # Most PostToolUse events only refresh the directory; avoid rewriting the
    # record when neither the state nor cwd changed.
    if event == "PostToolUse" and record.get("state") != "blocked":
        workdir = input_workdir(data.get("tool_input"))
        if workdir and workdir != record.get("cwd"):
            record["cwd"] = workdir
            record.pop("cwd_by", None)
            save(value, record)
        return

    # Title precedence: what the agent called itself, then what you named
    # the session, then the first line of your prompt as a last resort.
    extra = {}
    if event in ("UserPromptSubmit", "Stop"):
        named = session_name(data.get("session_id", ""))
        if named and record.get("title_by") != "agent":
            extra = {"title": named, "title_by": "session"}
        elif event == "UserPromptSubmit" and record.get("title_by") != "agent":
            guess = title_from_prompt(data)
            if guess:
                extra = {"title": guess, "title_by": "prompt"}
    workdir = input_workdir(data.get("tool_input"))
    if not workdir and event == "Stop":
        workdir = transcript_workdir(data)
    cwd = workdir or record.get("cwd", "") or data.get("cwd", "")
    set_state(value, record, state, agent=kind, cwd=cwd,
              thread=thread_id(data), **extra)


def session_name(session_id):
    """The name you set with /rename, if you set one.

    Auto-generated names carry nameSource "derived" and are ignored:
    "prgit-rbs-91" says less than the first line of your prompt.
    """
    if not session_id or not CLAUDE_SESSIONS.is_dir():
        return ""
    for path in CLAUDE_SESSIONS.glob("*.json"):
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if record.get("sessionId") != session_id:
            continue
        if record.get("nameSource") == "derived":
            return ""
        return (record.get("name") or "")[:44]
    return ""


def prompt_text(data):
    """What the user just asked for, whichever way the agent phrases it.

    claude sends `prompt` as a string; codex has sent `input-messages` as a
    list. Try the plausible spellings rather than pinning to one agent.
    """
    for key in ("prompt", "input-messages", "user_prompt", "message"):
        value = data.get(key)
        if isinstance(value, str) and value.strip():
            return value
        if isinstance(value, list) and value:
            first = value[0]
            if isinstance(first, str) and first.strip():
                return first
            if isinstance(first, dict):
                for inner in ("content", "text", "message"):
                    if isinstance(first.get(inner), str):
                        return first[inner]
    return ""


def title_from_prompt(data):
    """First line of what you asked for, as a stand-in title.

    Better than showing 'claude' for every window, and it costs nothing.
    An explicit `agent-state title` outranks it and is never overwritten.
    """
    line = next((l.strip() for l in prompt_text(data).splitlines()
                 if l.strip()), "")
    return line[:44]


def cmd_title(args):
    if not args:
        sys.exit("usage: agent-state title <text>")
    value = session_owner({})
    record = load(value)
    record["title"] = " ".join(args).strip()
    record["title_by"] = "agent"
    record["cwd"] = os.getcwd()
    record.pop("cwd_by", None)
    record.setdefault("state", "idle")
    record.setdefault("since", int(time.time()))
    record.setdefault("started", int(time.time() * 1000))
    save(value, record)


def cmd_agent(args):
    if not args:
        sys.exit("usage: agent-state agent <claude|codex>")
    value = session_owner({})
    record = load(value)
    record["agent"] = args[0]
    record.setdefault("state", "idle")
    record.setdefault("since", int(time.time()))
    record.setdefault("started", int(time.time() * 1000))
    save(value, record)


def cmd_clear(_args):
    remove(session_path(session_owner({})))


COMMANDS = {"hook": cmd_hook, "title": cmd_title, "name": cmd_title,
            "agent": cmd_agent, "clear": cmd_clear}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(f"usage: agent-state <{'|'.join(COMMANDS)}> [args]")
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
