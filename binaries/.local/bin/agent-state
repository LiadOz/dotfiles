#!/usr/bin/env python3
"""Record what a coding agent is doing, for the tmux status bar.

Runs wherever the agent runs -- on the LSF exec host, not on tlv. The agent
cannot reach tlv's tmux server, so it drops a small JSON file on shared
storage and agent-sync (on tlv) picks it up.

A "slot" is one tmux window, identified by its tmux window id (@7). Local
agents query tmux directly; remote agents use their inherited pane id and a
pane-to-window map published by the tmux host.

Called from claude/codex hooks, and by the agent itself for `title`.
"""
import json
import os
import pathlib
import subprocess
import sys
import time

# Shared by the tmux host and the LSF exec host.
STATE_DIR = pathlib.Path.home() / ".local/state/agent-slots"
FOCUS_PATH = STATE_DIR / "focus"
PANE_PATH = STATE_DIR / "panes"
_hook_owner = ""  # set once by cmd_hook; each invocation runs one command

# claude keeps one small file per running session here, keyed by pid, with
# the name you gave it via /rename. That name beats anything we could infer.
CLAUDE_SESSIONS = pathlib.Path.home() / ".claude/sessions"

# hook event -> flag shown in the status bar. claude and codex use the same
# event names, so one table serves both.
EVENTS = {
    "SessionStart": "idle",     # occupied, nothing pending
    "UserPromptSubmit": "working",
    "PermissionRequest": "blocked",
    "PostToolUse": "working",   # you answered the prompt; stop showing blocked
    "Stop": "done",
}


def remove(path):
    """Path.unlink(missing_ok=True) is 3.8+; tlv runs python 3.6."""
    try:
        path.unlink()
    except FileNotFoundError:
        pass

def slot_from_tmux():
    """Derive the window when the agent runs on the same machine as tmux.

    The LSF process retains $TMUX_PANE but cannot reach the original tmux
    socket. agent-sync publishes the pane-to-window mapping for that case.
    """
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return ""
    found = subprocess.run(
        ("tmux", "display-message", "-p", "-t", pane, "#{window_id}"),
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        universal_newlines=True, check=False,
    )
    if found.returncode == 0:
        return found.stdout.strip()
    try:
        return json.loads(PANE_PATH.read_text()).get(pane, "")
    except (OSError, ValueError):
        return ""


def slot_from_focus():
    """The window most recently focused on the tmux host."""
    try:
        return FOCUS_PATH.read_text().strip()
    except OSError:
        return ""


def owner(data):
    """Stable identity shared by every hook from one agent session."""
    return (data.get("session_id")
            or f"{os.uname().nodename}:{os.getppid()}")


def slot_from_owner(value):
    """The window this agent session claimed on its first hook."""
    for state_path in STATE_DIR.glob("*.json"):
        try:
            record = json.loads(state_path.read_text())
        except (OSError, ValueError):
            continue
        if record.get("owner") == value:
            return state_path.stem
    return ""


def slot():
    agent_owner = (os.environ.get("CODEX_THREAD_ID")
                   or os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
    value = (os.environ.get("AGENT_SLOT") or slot_from_tmux()
             or (_hook_owner and slot_from_owner(_hook_owner))
             or slot_from_owner(agent_owner)
             or slot_from_focus())
    if not value:
        sys.exit(0)
    return value.replace("/", "_")


def path():
    return STATE_DIR / f"{slot()}.json"


def load():
    try:
        return json.loads(path().read_text())
    except (OSError, ValueError):
        return {}


def save(record):
    target = path()
    record["slot"] = target.stem
    if _hook_owner:
        record["owner"] = _hook_owner
    else:
        record.setdefault("owner", owner({}))
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".tmp")
    tmp.write_text(json.dumps(record))
    tmp.replace(target)  # atomic: agent-sync never reads a half-written file

    # A delayed LSF startup may once have claimed the focused window. Once
    # its inherited pane id resolves, discard that session's wrong slot.
    for other in STATE_DIR.glob("*.json"):
        if other == target:
            continue
        try:
            existing = json.loads(other.read_text())
        except (OSError, ValueError):
            continue
        if existing.get("owner") == record.get("owner"):
            remove(other)


def set_state(state, **fields):
    record = load()
    if record.get("state") != state:
        record["since"] = int(time.time())
    record["state"] = state
    record.update({k: v for k, v in fields.items() if v})
    save(record)


def payload(args):
    """claude passes hook JSON on stdin; codex has passed it as an argument.
    Accept either rather than depending on which one this version does."""
    for arg in args:
        if arg.startswith("{"):
            try:
                return json.loads(arg)
            except ValueError:
                pass
    try:
        if not sys.stdin.isatty():
            return json.load(sys.stdin)
    except (ValueError, OSError):
        pass
    return {}


UUID_CHARS = set("0123456789abcdef-")


def thread_id(data):
    """The conversation id, whatever this agent calls it.

    codex has used thread-id, thread_id and conversation_id across versions,
    so match on shape rather than pinning one spelling: an id-ish key whose
    value looks like a uuid.
    """
    for key, value in data.items():
        if not isinstance(value, str) or len(value) < 32:
            continue
        if not set(value.lower()) <= UUID_CHARS:
            continue
        low = key.lower().replace("-", "_")
        if any(w in low for w in ("thread", "conversation", "session")):
            return value
    return ""


def cmd_hook(args):
    global _hook_owner
    # Which agent this is has to be told to us: no hook payload identifies
    # it, so each tool's config hardcodes it -- `agent-state hook claude`.
    kind = next((a for a in args if a in ("claude", "codex")), "")
    data = payload(args)
    _hook_owner = owner(data)
    event = data.get("hook_event_name") or data.get("type", "")

    if event in ("SessionEnd", "agent-turn-end"):
        set_state("free", agent=kind, cwd=data.get("cwd", ""),
                  thread=thread_id(data))
        return

    # codex's older notify path only ever reports turn completion
    if event == "agent-turn-complete":
        event = "Stop"

    if event not in EVENTS:
        return

    state = EVENTS[event]

    if event == "SessionStart":
        # Codex can restart within the same thread (for example after a
        # compaction). Keep the name and cwd that agent chose for that
        # thread; only a genuinely new occupant resets the slot.
        previous = load()
        same_owner = previous.get("owner") == _hook_owner
        record = {"state": "idle", "since": int(time.time()),
                  "agent": kind, "cwd": data.get("cwd", ""),
                  "thread": thread_id(data)}
        if same_owner and previous.get("title_by") == "agent":
            record.update({"title": previous.get("title", ""),
                           "title_by": "agent"})
        if same_owner and previous.get("cwd_by") == "agent":
            record.update({"cwd": previous.get("cwd", ""),
                           "cwd_by": "agent"})
        save(record)
        return

    record = load()

    # PostToolUse fires on every tool call, so keep it cheap: it exists only
    # to clear `blocked` once you have answered, and is a no-op otherwise.
    if event == "PostToolUse" and record.get("state") != "blocked":
        return

    # Title precedence: what the agent called itself, then what you named
    # the session, then the first line of your prompt as a last resort.
    extra = {}
    if event in ("UserPromptSubmit", "Stop"):
        named = session_name(data.get("session_id", ""))
        if named and record.get("title_by") != "agent":
            extra = {"title": named, "title_by": "session"}
        elif event == "UserPromptSubmit" and record.get("title_by") != "agent":
            guess = title_from_prompt(data)
            if guess:
                extra = {"title": guess, "title_by": "prompt"}
    cwd = (record.get("cwd", "") if record.get("cwd_by") == "agent"
           else data.get("cwd", ""))
    set_state(state, agent=kind, cwd=cwd,
              thread=thread_id(data), **extra)


def session_name(session_id):
    """The name you set with /rename, if you set one.

    Auto-generated names carry nameSource "derived" and are ignored:
    "prgit-rbs-91" says less than the first line of your prompt.
    """
    if not session_id or not CLAUDE_SESSIONS.is_dir():
        return ""
    for path in CLAUDE_SESSIONS.glob("*.json"):
        try:
            record = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if record.get("sessionId") != session_id:
            continue
        if record.get("nameSource") == "derived":
            return ""
        return (record.get("name") or "")[:44]
    return ""


def prompt_text(data):
    """What the user just asked for, whichever way the agent phrases it.

    claude sends `prompt` as a string; codex has sent `input-messages` as a
    list. Try the plausible spellings rather than pinning to one agent.
    """
    for key in ("prompt", "input-messages", "user_prompt", "message"):
        value = data.get(key)
        if isinstance(value, str) and value.strip():
            return value
        if isinstance(value, list) and value:
            first = value[0]
            if isinstance(first, str) and first.strip():
                return first
            if isinstance(first, dict):
                for inner in ("content", "text", "message"):
                    if isinstance(first.get(inner), str):
                        return first[inner]
    return ""


def title_from_prompt(data):
    """First line of what you asked for, as a stand-in title.

    Better than showing 'claude' for every window, and it costs nothing.
    An explicit `agent-state title` outranks it and is never overwritten.
    """
    line = next((l.strip() for l in prompt_text(data).splitlines()
                 if l.strip()), "")
    return line[:44]


def cmd_title(args):
    if not args:
        sys.exit("usage: agent-state title <text>")
    record = load()
    record["title"] = " ".join(args).strip()
    record["title_by"] = "agent"
    record["cwd"] = os.getcwd()
    record["cwd_by"] = "agent"
    record.setdefault("state", "idle")
    record.setdefault("since", int(time.time()))
    save(record)


def cmd_agent(args):
    if not args:
        sys.exit("usage: agent-state agent <claude|codex>")
    record = load()
    record["agent"] = args[0]
    record.setdefault("state", "idle")
    record.setdefault("since", int(time.time()))
    save(record)


def cmd_clear(_args):
    remove(path())


COMMANDS = {"hook": cmd_hook, "title": cmd_title, "name": cmd_title,
            "agent": cmd_agent, "clear": cmd_clear}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(f"usage: agent-state <{'|'.join(COMMANDS)}> [args]")
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
