[Unit]
Description=WebRTC echo cancellation for voice control and narration
After=pipewire-pulse.service
Requires=pipewire-pulse.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/voice-echo-cancel start
ExecStop=%h/.local/bin/voice-echo-cancel stop
RemainAfterExit=yes

[Install]
WantedBy=default.target
