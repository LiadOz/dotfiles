[Unit]
Description=Kokoro-FastAPI text-to-speech server (local, GPU)
Documentation=https://github.com/remsky/Kokoro-FastAPI

[Service]
WorkingDirectory=%h/.local/share/kokoro-fastapi
Environment=USE_GPU=true
Environment=USE_ONNX=false
Environment=PYTHONPATH=%h/.local/share/kokoro-fastapi:%h/.local/share/kokoro-fastapi/api
Environment=MODEL_DIR=src/models
Environment=VOICES_DIR=src/voices/v1_0
ExecStart=%h/.local/share/tts-venv/bin/uvicorn api.src.main:app --host 127.0.0.1 --port 8880
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
